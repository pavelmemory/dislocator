# Copy to .env and adjust for your environment.
# docker-compose reads this file automatically.

# --- Postgres ---
POSTGRES_USER=dislocator
POSTGRES_PASSWORD=dislocator
POSTGRES_DB=dislocator

# --- Backend ---
# Secret used to sign JWT access tokens. CHANGE THIS to a long random string.
JWT_SECRET=change-me-in-production

# Public URL of the frontend, used when generating signup links.
# For the local prototype behind Caddy this is https://localhost.
FRONTEND_URL=https://localhost

# Initial admin, seeded on first startup only (if the login does not yet exist).
# Defaults to test/test if unset. Set strong values for any public deployment.
ADMIN_LOGIN=test
ADMIN_PASSWORD=test
